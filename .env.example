# Copy to .env and customize before running `docker compose up`.

# --- SQL Server ---
MSSQL_SA_PASSWORD=ChangeMe_Str0ngPass!
MSSQL_PORT=1433

# --- JWT ---
# Generate a 64-byte random key:  openssl rand -base64 64
JWT_SIGNING_KEY=replace-with-base64-64-bytes
JWT_ISSUER=openquiz
JWT_AUDIENCE=openquiz
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# --- Google Sign-In ---
# Create at https://console.cloud.google.com/apis/credentials → "OAuth 2.0 Client IDs" (Web)
# Authorized JavaScript origins must include PUBLIC_URL.
GOOGLE_CLIENT_ID=

# --- SMTP (optional; required only for password reset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@openquiz.local
SMTP_FROM_NAME=OpenQuiz
SMTP_USE_STARTTLS=true

# --- App ---
ADMIN_EMAIL=
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080
API_PORT=5080

# Backend URL the React app calls. Leave empty: nginx in the web container
# reverse-proxies /api and /hubs to the api service, so the frontend uses
# relative URLs and works on any LAN IP/hostname automatically.
VITE_API_BASE_URL=
ASPNETCORE_ENVIRONMENT=Production

# --- Scale-out (optional) ---
# Required only when more than one api replica runs; SignalR groups do not
# cross processes without it. See docs/SELF_HOSTING.md.
REDIS_CONNECTION_STRING=

# --- Observability (optional) ---
# PROMETHEUS_ENABLED opens an unauthenticated /metrics on the api port; keep
# that port off the public internet. OTLP_ENDPOINT ships metrics and traces to
# a collector, e.g. http://otel-collector:4317
PROMETHEUS_ENABLED=false
OTLP_ENDPOINT=

# --- Billing (optional; off by default) ---
# Every self-hosted install runs unmetered until you opt in here — leaving
# BILLING_ENABLED=false is what makes upgrading this compose file safe.
BILLING_ENABLED=false
BILLING_PROVIDER=manual
BILLING_DEFAULT_PLAN=unlimited
# Grandfathering: accounts created before this UTC timestamp resolve to
# BILLING_LEGACY_PLAN instead of BILLING_DEFAULT_PLAN. Leave both empty to skip.
BILLING_LEGACY_PLAN=
BILLING_LEGACY_CUTOFF=
BILLING_CURRENCY=TRY
BILLING_WEBHOOK_SECRET=

# --- Container resource limits ---
# SQL Server will not start under 2 GB.
DB_MEMORY_LIMIT=4g
DB_CPU_LIMIT=2.0
API_MEMORY_LIMIT=1g
API_CPU_LIMIT=1.5
WEB_MEMORY_LIMIT=256m
WEB_CPU_LIMIT=0.5
